{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.foxintelligence.co.uk/omnisynapse/task_proposal.schema.json",
  "title": "OMNISYNAPSE task_proposal",
  "type": "object",
  "required": [
    "task_id",
    "requested_by",
    "target_system",
    "required_scope",
    "risk_tier",
    "approval_status",
    "budget_cap_gbp",
    "reason",
    "evidence_ids"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "requested_by": {
      "type": "string"
    },
    "target_system": {
      "type": "string"
    },
    "required_scope": {
      "type": "string"
    },
    "risk_tier": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "approval_status": {
      "enum": [
        "required",
        "approved",
        "rejected"
      ]
    },
    "budget_cap_gbp": {
      "type": "number",
      "minimum": 0
    },
    "reason": {
      "type": "string"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
